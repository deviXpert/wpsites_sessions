vice.ca/flat-tire-change-or-replacement/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "image": {"id": 1096, "url": "https://bptowingservice.ca/wp-content/uploads/2025/04/flat-tire-76563_1280-e1745512221840.jpg", "size": "", "alt": "", "source": "library"}, "thumbnail_size": "medium_large", "title_size": "h3", "_css_classes": "bp-card bp-glass bp-spot"}, "elements": []}]}, {"id": "3778d23", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "bp-cardwrap bp-col", "animation": "fadeInUp", "animation_delay": 240}, "elements": [{"id": "adec379", "elType": "widget", "widgetType": "image-box", "isInner": false, "settings": {"title_text": "Battery Boost & Jump Start", "description_text": "24/7 jump starts \u2013 even in extreme cold. Dead battery? We'll get you running in minutes. BP Towing Service provides rapid-response battery boosting across Calgary with heavy-duty equipment for cars, trucks, and SUVs. Available 24 hours a day, 7 days a week\u2014even during harsh winter conditions.", "link": {"url": "https://bptowingservice.ca/vehicle-jump-start-calgary/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "image": {"id": 1184, "url": "https://bptowingservice.ca/wp-content/uploads/2025/04/Copy-of-Stylize-Your-View.-Elevate-Your-Space.-1.jpg", "size": "", "alt": "On-Demand Vehicle Jump Start Service", "source": "library"}, "thumbnail_size": "medium_large", "title_size": "h3", "_css_classes": "bp-card bp-glass bp-spot"}, "elements": []}]}, {"id": "b0c8819", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "bp-cardwrap bp-col", "animation": "fadeInUp", "animation_delay": 0}, "elements": [{"id": "5b5109e", "elType": "widget", "widgetType": "image-box", "isInner": false, "settings": {"title_text": "Cash for Junk Cars & Scrap Vehicles", "description_text": "Top cash paid \u2013 free removal. Turn your unwanted vehicle into instant cash. We buy junk cars, scrap vehicles, and damaged cars in any condition\u2014running or not. Competitive offers, free towing, and hassle-free removal across Calgary. No hidden fees. No paperwork stress.\n\n", "image": {"id": 4392, "url": "https://bptowingservice.ca/wp-content/uploads/2026/07/Auction-Vehicle-Towing-Calgary.jpeg", "size": "", "alt": "", "source": "library"}, "thumbnail_size": "medium_large", "title_size": "h3", "_css_classes": "bp-card bp-glass bp-spot"}, "elements": []}]}, {"id": "1a1ebb1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "bp-cardwrap bp-col", "animation": "fadeInUp", "animation_delay": 120}, "elements": [{"id": "52b155d", "elType": "widget", "widgetType": "image-box", "isInner": false, "settings": {"title_text": "Emergency Fuel Delivery", "description_text": "Gas, diesel & premium \u2013 delivered to you. Ran out of gas? We bring fuel to your location. BP Towing Service delivers regular, premium, and diesel fuel directly to stranded vehicles across Calgary and surrounding areas. Fast response, clean delivery, and no need for a tow.", "link": {"url": "https://bptowingservice.ca/fuel-delivery/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "image": {"id": 1114, "url": "https://bptowingservice.ca/wp-content/uploads/2025/04/fueldelivery.jpg", "size": "", "alt": "Fuel Delivery Services in Calgary", "source": "library"}, "thumbnail_size": "medium_large", "title_size": "h3", "_css_classes": "bp-card bp-glass bp-spot"}, "elements": []}]}, {"id": "5ca1335", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "bp-cardwrap bp-col", "animation": "fadeInUp", "animation_delay": 240}, "elements": [{"id": "6a4c643", "elType": "widget", "widgetType": "image-box", "isInner": false, "settings": {"title_text": "Winch-Out & Vehicle Recovery", "description_text": "Profession