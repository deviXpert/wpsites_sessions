escription_text": "On-site mobile tire assistance anywhere in Calgary. We handle flat tire changes, patch repairs, and full replacements at your home, work, or roadside. Professional technicians arrive with all necessary tools. Fast, safe, and convenient.", "link": {"url": "https://bptowingservice.ca/flat-tire-change-or-replacement/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "image": {"id": 1096, "url": "https://bptowingservice.ca/wp-content/uploads/2025/04/flat-tire-76563_1280-e1745512221840.jpg", "size": "", "alt": "", "source": "library"}, "thumbnail_size": "medium_large", "title_size": "h3", "_css_classes": "bp-card bp-glass bp-spot"}, "elements": []}]}, {"id": "1a1b697", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "bp-cardwrap bp-col", "animation": "fadeInUp", "animation_delay": 240}, "elements": [{"id": "b4238b9", "elType": "widget", "widgetType": "image-box", "isInner": false, "settings": {"title_text": "Battery Boost & Jump Start", "description_text": "24/7 jump starts \u2013 even in extreme cold. Dead battery? We'll get you running in minutes. BP Towing Service provides rapid-response battery boosting across Calgary with heavy-duty equipment for cars, trucks, and SUVs. Available 24 hours a day, 7 days a week\u2014even during harsh winter conditions.", "link": {"url": "https://bptowingservice.ca/vehicle-jump-start-calgary/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "image": {"id": 1184, "url": "https://bptowingservice.ca/wp-content/uploads/2025/04/Copy-of-Stylize-Your-View.-Elevate-Your-Space.-1.jpg", "size": "", "alt": "On-Demand Vehicle Jump Start Service", "source": "library"}, "thumbnail_size": "medium_large", "title_size": "h3", "_css_classes": "bp-card bp-glass bp-spot"}, "elements": []}]}, {"id": "506b62a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "bp-cardwr